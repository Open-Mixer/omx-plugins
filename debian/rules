#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Pau Aliagas <linuxnow@gmail.com>

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

%:
	dh $@

# CLAP and LV2 hosts look in /usr/lib/clap and /usr/lib/lv2, not in the multiarch directory
override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr LIBDIR=/usr/lib
	# libomxplugins.a and omxplugins.pc are the -dev package's, in the multiarch directory
	$(MAKE) install-devel DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH)
	# the test instruments are omx-plugins-test's, outside every CLAP search path
	$(MAKE) install-test DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr TESTCLAPDIR=/usr/libexec/omx-plugins/test
	@# every shipped descriptor carries this release's version and the checkout's commit, the tag's (#32)
	tools/integrity-check.sh $(CURDIR)/debian/tmp/usr/share/omx-contract/contract.d $(shell dpkg-parsechangelog -S Version | sed 's/-[^-]*$$//; s/[~+].*//') $(shell git rev-parse HEAD)

# the shipped .clap is the stripped one, so its pin is measured again after dh_strip: a pin taken at
# dh_auto_install names bytes the package never ships. The binaries sit in omx-plugins-clap's tree,
# the pins file in omx-plugins'; then the shipped pins.d file is held to the shipped binaries' own
# hashes (sabotage: a changed binary goes red)
override_dh_strip:
	dh_strip
	$(MAKE) -s install-pins DESTDIR=$(CURDIR)/debian/omx-plugins-clap PREFIX=/usr LIBDIR=/usr/lib
	mv debian/omx-plugins-clap/usr/share/plugin-hostd/pins.d/omx-plugins.pins debian/omx-plugins/usr/share/plugin-hostd/pins.d/omx-plugins.pins
	rm -r debian/omx-plugins-clap/usr/share/plugin-hostd
	tools/pins-check.sh debian/omx-plugins/usr/share/plugin-hostd/pins.d/omx-plugins.pins debian/omx-plugins-clap/usr/lib/clap

# The generators read omx-contract's contract directory through the omx-contract command, a build
# dependency (omx-contract's .deb): make test runs whole, as it does in the RPM build.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	@# a CI build host holds the channel's omx-plugins-contract before 0.17.0, whose units sheet omx-contract 3.6.0 now
	@# declares: tools/ci-stale-units.sh drops it there (only under CI, never on a user's system), until 0.17.0 is out
	@[ -z "$$CI$$GITHUB_ACTIONS" ] || [ "$$(id -u)" != 0 ] || tools/ci-stale-units.sh
	$(MAKE) test OMX_LV2_SPEC_DIR=/usr/lib/lv2
endif
