}

{{/chain}}{{#chain}}/* The chain's length, and its element `k` of the order the `order` value `row` names: the row-th
 * permutation of 0..LENGTH-1 in lexicographic order, computed here (not read from the binding's table). */
#define LENGTH {{length}}u
static uint32_t element_at(uint32_t row, uint32_t k) {
  uint32_t left[LENGTH], n = LENGTH, e = 0;
  for (uint32_t i = 0; i < LENGTH; i++) left[i] = i;
  for (uint32_t i = 0; i <= k; i++, n--) {
    uint32_t f = 1; /* (n - 1)! */
    for (uint32_t j = 2; j < n; j++) f *= j;
    const uint32_t q = row / f;
    row %= f;
    e = left[q];
    for (uint32_t j = q; j + 1 < n; j++) left[j] = left[j + 1];
  }
  return e;
}

/* The reference: omx-dsp's instance faces of the chain, called directly, on the same blocks: in to out,
 * then each element in place in the order the block's `order` names, its switch off or the host's bypass
 * its bypass. */
static void reference(double sr, int off, const float *key, const float *il, const float *ir, float *ol, float *orr,
                      uint32_t *latency) {
{{#elements}}  static {{faceType}} {{id}};
  (void)omx_{{face}}_instance_init(&{{id}}, ({{srType}})sr);
{{/elements}}  (void)key;
  uint32_t at = 0;
  for (size_t b = 0; b < NBLOCKS; b++) {
    const Block *k = &PLAN[b];
    float values[NP];
    values_of(k, off, values);
    const uint32_t whole = frames_of(k, sr);
    for (uint32_t r = 0; r < STRETCH; r++)
      for (uint32_t left = whole, frames; left; left -= frames) {
      frames = part_of(whole, left);
{{#elements}}      omx_{{face}}_instance_resolve(&{{id}}, k->bypass || values[{{on}}] < 0.5f{{#binding}}, {{value}}{{/binding}});
{{/elements}}{{#permutable}}      const uint32_t row = (uint32_t)lrintf(values[{{orderParam}}]);
{{/permutable}}{{^permutable}}      const uint32_t row = 0;
{{/permutable}}      memcpy(ol + at, il + at, (size_t)frames * sizeof(float));
      memcpy(orr + at, ir + at, (size_t)frames * sizeof(float));
      for (uint32_t s = 0; s < LENGTH; s++) {
        switch (element_at(row, s)) {
{{#elements}}        case {{index}}:
          omx_{{face}}_instance_{{runFn}}(&{{id}}, {{#keyedFace}}{{keyRef}}, {{/keyedFace}}ol + at, orr + at, ol + at, orr + at, frames);
          break;
{{/elements}}        }
