{{#metered}}      if (meters_want) {
        double *mw = meters_want + (b * STRETCH + r) * NV;
{{#meters}}{{#isRead}}        mw[{{meterOffset}}] = k->bypass ? {{meterBypassRef}} : (double){{meterReadRef}};
{{/isRead}}{{#isIn}}        mw[{{meterOffset}}] = ref_level(il + at, frames, METERS[{{meterIndex}}].min);
        mw[{{meterRight}}] = ref_level(ir + at, frames, METERS[{{meterIndex}}].min);
{{/isIn}}{{#isOut}}        mw[{{meterOffset}}] = ref_level(ol + at, frames, METERS[{{meterIndex}}].min);
        mw[{{meterRight}}] = ref_level(orr + at, frames, METERS[{{meterIndex}}].min);
{{/isOut}}{{/meters}}      }
