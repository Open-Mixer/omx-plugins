        if (METERS[m].kind == CLAP_METER_KIND_LEVEL{{#meterKernelLevel}} && METERS[m].channels == 2u{{/meterKernelLevel}}) legs = legs || v[0] != v[1];
        for (uint32_t o = 0; o < NM; o++)
          if (o != m && METERS[o].kind == CLAP_METER_KIND_LEVEL && METERS[m].kind == CLAP_METER_KIND_LEVEL{{#meterKernelLevel}} &&
