    check(agrees, face, sr, what);
{{#meterGr}}    snprintf(what, sizeof what, "the kernel reduces gain in the plan%s", pass);
    check(reduces, face, sr, what);
{{/meterGr}}{{#meterLevel}}    snprintf(what, sizeof what, "the levels of the two legs differ in the plan%s", pass);
    check(legs, face, sr, what);
{{/meterLevel}}{{#meterIn}}{{#meterOut}}    snprintf(what, sizeof what, "the input and output levels differ in the plan%s", pass);
    check(shaped, face, sr, what);
{{/meterOut}}{{/meterIn}}    if (!lv2) {
