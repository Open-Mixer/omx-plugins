/*
 * omx_{{kernel}}_core.h — {{stem}}'s binding to omx-dsp's {{kernel}} kernel: the ONE place both faces
 * (omx_{{kernel}}_clap.c, omx_{{kernel}}_lv2.c) reach the DSP. It holds no DSP of its own: it hands the
 * declared parameter values, by name, to omx-dsp's instance face (<omxdsp/fx/omx_{{face}}_instance.h>)
 * and runs it. The instance is plain inline state: nothing is allocated, locked or called into the
 * system, in process or at activate.
 *
 * GENERATED — DO NOT EDIT BY HAND. Produced by tools/gen.mjs from plugins/{{stem}}/{{stem}}.decl.json and
 * the face's resolve() prototype: each argument takes the parameter whose contract control it names.
{{#renames}} * RENAME OWED by omx-dsp's name conformance: resolve argument `{{arg}}` is the contract's `{{rename}}`.
{{/renames}}{{#heldArgs}} * `{{arg}}` is no parameter: the declaration holds it at its kernel's declared default, {{at}}.
{{/heldArgs}}{{#fixed}} * `{{control}}` is not a parameter of this plugin: it is passed at {{at}}.
{{/fixed}} */
#ifndef OMX_{{K}}_CORE_H
#define OMX_{{K}}_CORE_H

#include <math.h>
#include <stdint.h>
#include <string.h>

/* The generated table FIRST: its guard is omx-dsp's own, so the instance header reads this table. */
#include "omx_{{kernel}}_params.h"
#include "omx_plugin_face.h"

#include <omxdsp/fx/omx_{{face}}_instance.h>
{{#meterLinear}}#include <omxdsp/omx_dyn.h>
{{/meterLinear}}{{#arrays}}
_Static_assert({{count}} == {{extent}}, "the declaration names one {{arg}} parameter per band of the face");
{{/arrays}}
/** The kernel's state and what a block runs with. */
typedef struct {
  uint32_t rate;
  {{faceType}} inst;
} Omx{{Kernel}}Core;

/** A fresh instance at `rate`: every state word zero. 1 when the kernel takes the rate, 0 when it refuses
 * it (the instance is then the identity: the caller must not run it). */
static inline int omx_{{kernel}}_core_init(Omx{{Kernel}}Core *c, uint32_t rate) {
  memset(c, 0, sizeof *c);
  c->rate = rate;
  return omx_{{face}}_instance_init(&c->inst, ({{srType}})rate);
}

/** The block's parameters (declaration order) and the host's bypass, each to its resolve() argument. */
static inline void omx_{{kernel}}_core_resolve(Omx{{Kernel}}Core *c, const float *values, int bypass) {
  omx_{{face}}_instance_resolve(&c->inst, bypass{{#binding}},
                                  /* {{arg}} */ {{value}}{{/binding}});
}

/** The latency the kernel adds, in samples. */
static inline uint32_t omx_{{kernel}}_core_latency(const Omx{{Kernel}}Core *c) {
  (void)c;
  return (uint32_t)lrintf((float)({{latency}}));
}

{{#meterRead}}/** {{^meterKernelLevel}}Gain-reduction meter{{/meterKernelLevel}}{{#meterKernelLevel}}Kernel-read meter (a gain reduction, or a level the kernel reads){{/meterKernelLevel}} `i`'s reading (the declaration's `meters`, in order): the kernel's own, after the
 * last block. */
static inline float omx_{{kernel}}_core_meter(const Omx{{Kernel}}Core *c, uint32_t i) {
  switch (i) {
{{#meters}}{{#isRead}}  case {{meterIndex}}:
    return {{meterReadCore}};
{{/isRead}}{{/meters}}  default:
    return 0.0f;
  }
}

{{/meterRead}}{{#tempo}}/** The host's tempo for the next resolve, BPM; 0 (or any non-positive value) is none: the kernel keeps its time
 * control. */
static inline void omx_{{kernel}}_core_tempo(Omx{{Kernel}}Core *c, double bpm) {
  omx_{{face}}_instance_set_tempo(&c->inst, (float)bpm);
}

{{/tempo}}{{^keyed}}/** One block, stereo; the outputs may alias the inputs. */
static inline void omx_{{kernel}}_core_run(Omx{{Kernel}}Core *c, const float *in_l, const float *in_r, float *out_l,
                                         float *out_r, uint32_t frames) {
  omx_{{face}}_instance_run(&c->inst, in_l, in_r, out_l, out_r, frames);
}
{{/keyed}}{{#keyed}}/** One block, stereo, keyed by `key` (NULL: nothing routed to the key, the kernel's own detector);
 * the outputs may alias the inputs or the key. */
static inline void omx_{{kernel}}_core_run(Omx{{Kernel}}Core *c, const float *key, const float *in_l, const float *in_r,
                                         float *out_l, float *out_r, uint32_t frames) {
  omx_{{face}}_instance_{{runFn}}(&c->inst, key{{keyTail}}, in_l, in_r, out_l, out_r, frames);
}
