      }
    },
    {
      "id": 3,
      "symbol": "compKey",
      "name": "Key level",
      "doc": "The level the compressor's detector reads now, dBFS: the key after its filter, tilt and fold while one is set, the programme's louder leg otherwise. The display range is the threshold's travel, so the meter and the threshold share one axis.",
      "kind": "level",
      "channels": 1,
      "unit": "dBFS",
      "min": -60,
      "max": 0,
      "scale": "linear",
      "source": {
