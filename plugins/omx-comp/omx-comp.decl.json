{
  "$comment": "The extras of omx-comp's declaration: what its descriptor, omx-comp.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's comp kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-comp",
  "kernel": "comp",
  "kernels": [
    "comp"
  ],
  "url": "https://github.com/Open-Mixer/omx-plugins",
  "binding": "instance",
  "held": [
    "releaseMode"
  ],
  "sidechain": {
    "symbol": "key",
    "name": "Key (Sidechain)"
  },
  "portHints": {
    "thresholdDb": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:db"
    },
    "kneeDb": {
      "unit": "units:db"
    },
    "attackMs": {
      "unit": "units:ms"
    },
    "releaseMs": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "makeupDb": {
      "unit": "units:db"
    },
    "mixPct": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:pc"
    },
    "kind": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Compressor",
        "1 Limiter"
      ]
    },
    "detectorOversampling": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Auto",
        "1 Off",
        "2 4x"
      ]
    },
    "detectorTopology": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Feedforward",
        "1 Feedback"
      ]
    },
    "key": {
      "props": [
        "lv2:connectionOptional",
        "lv2:isSideChain"
      ]
    },
    "keySource": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Self",
        "1 Sidechain"
      ]
    },
    "keyHpHz": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:hz"
    },
    "keyLpHz": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:hz"
    },
    "keyListen": {
      "props": [
        "lv2:toggled"
      ]
    },
    "holdMs": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:ms"
    },
    "detectLink": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Linked",
        "1 Mid",
        "2 Side",
        "3 Max"
      ]
    },
    "duck": {
      "props": [
        "lv2:toggled"
      ]
    },
    "rangeDb": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:db"
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:frame"
    }
  },
  "resourceHints": {
    "threads-spawned": 0,
    "streams-from-disk": false,
    "opens-sockets": false
  },
  "oracles": [
    "comp-key"
  ],
  "monitors": [
    "keyListen"
  ],
  "meters": [
    {
      "id": "compGr",
      "kind": "gain_reduction",
      "field": "st.gr_min_db",
      "readout": "GAIN_REDUCTION_DB"
    },
    {
      "id": "compIn",
      "kind": "level",
      "source": "input",
      "min": -60,
      "max": 6
    },
    {
      "id": "compOut",
      "kind": "level",
      "source": "output",
      "min": -60,
      "max": 6
    },
    {
      "id": "compKey",
      "kind": "level",
      "read": "key_level_db",
      "readout": "KEY_LEVEL_DB"
    }
  ],
  "panel": {
    "family": "dynamics",
    "roles": {
      "threshold": "thresholdDb",
      "ratio": "ratio",
      "attack": "attackMs",
      "release": "releaseMs",
      "knee": "kneeDb",
      "makeup": "makeupDb",
      "mix": "mixPct"
    },
    "sections": [
      {
        "key": "comp",
        "label": "Comp",
        "graph": "dynamics-curve",
        "controls": [
          "thresholdDb",
          "ratio",
          "kneeDb",
          "attackMs",
          "releaseMs",
          "holdMs",
          "makeupDb",
          "mixPct",
          "kind",
          "detectorOversampling",
          "detectorTopology"
        ]
      },
      {
        "key": "key",
        "label": "Key",
        "controls": [
          "keySource",
          "keyHpHz",
          "keyLpHz",
          "keyTiltDb",
          "detectLink",
          "keyListen"
        ]
      },
      {
        "key": "duck",
        "label": "Duck",
        "controls": [
          "duck",
          "rangeDb"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The compressor as a dynamics stage of the console walk: one section of the ten controls, in declaration order. Its placement follows the other dynamics stages (gate, de-esser); the card, chip and graph the console draws for it are not declared yet.",
    "placement": {
      "group": "walk",
      "stage": "comp",
      "after": "deEsser",
      "fxGroup": "dynamics"
    }
  }
}
