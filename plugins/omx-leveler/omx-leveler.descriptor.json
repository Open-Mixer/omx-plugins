{
  "$schema": "https://github.com/FreeMixer/omx-contract/raw/v3/schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 3.7.0"
  },
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.leveler",
    "format": "clap",
    "uri": "urn:openmixer:leveler",
    "name": "omx leveler",
    "vendor": "openmixer",
    "version": "0.19.3",
    "doc": "Rides a signal's level up, down or both ways, by how much and how fast you set.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "amount",
      "name": "Amount",
      "kind": "travel",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 0,
        "scale": "stepped"
      },
      "group": [
        "Leveler"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/leveler.json#LEVELER_AMOUNT_RANGE",
          "at": "omx-dsp@0.32.0"
        }
      }
    },
    {
      "id": 1,
      "symbol": "direction",
      "name": "Direction",
      "kind": "choice",
      "ids": [
        "0",
        "1",
        "2"
      ],
      "labels": [
        "Down",
        "Up",
        "Both"
      ],
      "values": [
        0,
        1,
        2
      ],
      "default": "2",
      "group": [
        "Leveler"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/leveler.json#LEVELER_DIRECTIONS",
          "at": "omx-dsp@0.32.0"
        }
      }
    },
    {
      "id": 2,
      "symbol": "speed",
      "name": "Speed",
      "kind": "choice",
      "ids": [
        "0",
        "1",
        "2"
      ],
      "labels": [
        "Slow",
        "Medium",
        "Fast"
      ],
      "values": [
        0,
        1,
        2
      ],
      "default": "1",
      "group": [
        "Leveler"
      ],
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/leveler.json#LEVELER_SPEEDS",
          "at": "omx-dsp@0.32.0"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:UtilityPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-leveler/omx_leveler_clap.c#clap_entry"
  }
}
