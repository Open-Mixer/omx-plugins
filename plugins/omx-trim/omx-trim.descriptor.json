{
  "$schema": "../schema/omx-contract.schema.json",
  "origin": "authored",
  "plugin": {
    "id": "org.openmixer.trim",
    "format": "clap",
    "uri": "urn:openmixer:trim",
    "name": "omx trim",
    "vendor": "openmixer",
    "version": "0.21.0",
    "doc": "The OpenMixer console's input trim: one gain control, -24 to +24 dB in 0.1 dB steps, applied first in the channel as a click-free ramp, stereo, zero latency; at 0 dB a racked instance is a wire.",
    "features": [
      "audio-effect"
    ]
  },
  "controls": [
    {
      "id": 0,
      "symbol": "trimDb",
      "name": "Trim",
      "kind": "travel",
      "travel": {
        "min": -24,
        "max": 24,
        "step": 0,
        "unit": "dB",
        "default": 0,
        "scale": "linear"
      },
      "group": [
        "Trim"
      ],
      "meaning": "gain",
      "automatable": true,
      "source": {
        "from": {
          "link": "data/kernels/trim.json#TRIM_RANGE",
          "at": "omx-dsp@0.34.1"
        }
      }
    }
  ],
  "ports": [
    {
      "id": 0,
      "name": "in",
      "kind": "audio",
      "direction": "in",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    },
    {
      "id": 0,
      "name": "out",
      "kind": "audio",
      "direction": "out",
      "role": "main",
      "channels": 2,
      "layout": "stereo"
    }
  ],
  "needs": {
    "extensions": {
      "optional": [
        "lv2:hardRTCapable"
      ]
    }
  },
  "latency": {
    "reports": true
  },
  "extensions": {
    "clap": {
      "clap_plugin_descriptor.features": [
        "CLAP_PLUGIN_FEATURE_MIXING",
        "CLAP_PLUGIN_FEATURE_STEREO"
      ]
    },
    "lv2": {
      "rdf:type": [
        "lv2:Plugin",
        "lv2:MixerPlugin"
      ]
    }
  },
  "source": {
    "impl": "plugins/omx-trim/omx_trim_clap.c#clap_entry"
  }
}
