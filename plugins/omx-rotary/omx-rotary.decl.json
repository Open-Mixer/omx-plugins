{
  "$comment": "The extras of omx-rotary's declaration: what its descriptor, omx-rotary.descriptor.json, has no word for (docs/declaration-as-descriptor.md). The two are the folder's hand-written files; tools/gen.mjs generates the rest and writes the travels the descriptor's links resolve to. Its parameters are by reference to omx-contract's rotary kernel and bind by name to omx-dsp's instance face. Control order, the descriptor's, is append-only.",
  "stem": "omx-rotary",
  "kernel": "rotary",
  "kernels": [
    "rotary"
  ],
  "url": "https://github.com/Open-Mixer/omx-plugins",
  "binding": "instance",
  "controls": {
    "speed": {
      "values": [
        "Stop",
        "Slow",
        "Fast"
      ],
      "defaultId": "slow"
    }
  },
  "portHints": {
    "hornSlowHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "hornFastHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "drumSlowHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "drumFastHz": {
      "props": [
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "balance": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:pc"
    },
    "mix": {
      "unit": "units:pc"
    },
    "speed": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Stop",
        "1 Slow",
        "2 Fast"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:frame"
    }
  },
  "resourceHints": {
    "threads-spawned": 0,
    "streams-from-disk": false,
    "opens-sockets": false
  },
  "panel": {
    "family": "modulation",
    "roles": {
      "mix": "mix"
    },
    "sections": [
      {
        "key": "rotary",
        "label": "Rotary",
        "controls": [
          "hornSlowHz",
          "hornFastHz",
          "drumSlowHz",
          "drumFastHz",
          "accel",
          "balance",
          "mix",
          "speed"
        ]
      }
    ]
  },
  "console": {
    "$comment": "The console has the rotary stage in its walk, with no contract yet, and draws no panel, chip or card for it today; racked as a plugin it is drawn by the generic plugin editor.",
    "placement": {
      "group": "walk",
      "stage": "rotary",
      "after": "drive",
      "fxGroup": "modulation"
    }
  }
}
