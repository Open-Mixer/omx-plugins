{
  "$comment": "THE declaration of the channel EQ's three plugins, omx-eq8, omx-eq16 and omx-eq32: ONE file for three band counts (tools/variants.mjs), the folders plugins/omx-eq8, omx-eq16 and omx-eq32 hold only what tools/gen.mjs writes from it. Its parameters are by reference to omx-contract's eq kernel and bind by name to omx-dsp's instance face; the per-band ones repeat for every band. Parameter order is append-only.",
  "stem": "omx-eq",
  "kernel": "eq",
  "kernels": [
    "eq"
  ],
  "variants": {
    "count": "EQ_BAND_COUNTS",
    "of": [
      {
        "stem": "omx-eq8",
        "count": "eq8"
      },
      {
        "stem": "omx-eq16",
        "count": "eq16"
      },
      {
        "stem": "omx-eq32",
        "count": "eq32"
      }
    ]
  },
  "name": "omx eq",
  "noun": "{bands}-band EQ",
  "vendor": "openmixer",
  "url": "https://github.com/Open-Mixer/omx-plugins",
  "version": "0.13.0",
  "description": "The OpenMixer console's channel EQ, {bands}-band form: {bands} parametric bands (bell, shelves, notch, all-pass) and a high-pass and a low-pass filter at 12 or 24 dB/oct, stereo, zero latency; every band ships off, so a racked instance is a wire.",
  "summary": "The console's channel EQ in its {bands}-band form: {bands} parametric bands (bell, shelves, notch, all-pass) plus high- and low-pass filters at {min:hpf_slope} or {max:hpf_slope} dB/oct. Stereo, zero latency.",
  "clap": {
    "id": "org.openmixer.eq",
    "features": [
      "audio-effect",
      "equalizer",
      "stereo"
    ]
  },
  "lv2": {
    "uri": "urn:openmixer:eq",
    "class": "lv2:ParaEQPlugin"
  },
  "binding": "instance",
  "params": [
    {
      "symbol": "hpf_on",
      "name": "HPF On",
      "ref": "EQ_HPF_ONS"
    },
    {
      "symbol": "hpf_freq",
      "name": "HPF Frequency",
      "ref": "HPF_FREQ_RANGE",
      "defaultRef": "EQ_PASS_FILTER_DEFAULTS.hpfFreqHz"
    },
    {
      "symbol": "hpf_slope",
      "name": "HPF Slope",
      "ref": "FILTER_SLOPES",
      "unit": "dB/oct"
    },
    {
      "symbol": "lpf_on",
      "name": "LPF On",
      "ref": "EQ_LPF_ONS"
    },
    {
      "symbol": "lpf_freq",
      "name": "LPF Frequency",
      "ref": "LPF_FREQ_RANGE",
      "defaultRef": "EQ_PASS_FILTER_DEFAULTS.lpfFreqHz"
    },
    {
      "symbol": "lpf_slope",
      "name": "LPF Slope",
      "ref": "FILTER_SLOPES",
      "unit": "dB/oct"
    },
    {
      "symbol": "type",
      "name": "Type",
      "ref": "EQ_BAND_TYPES",
      "perBand": true,
      "defaultBand": {
        "of": "type"
      }
    },
    {
      "symbol": "freq",
      "name": "Frequency",
      "ref": "EQ_FREQ_RANGE",
      "perBand": true,
      "defaultBand": {
        "of": "centre"
      }
    },
    {
      "symbol": "gain",
      "name": "Gain",
      "ref": "EQ_GAIN_RANGE",
      "perBand": true,
      "defaultRef": "EQ_BAND_DEFAULTS.gainDb"
    },
    {
      "symbol": "q",
      "name": "Q",
      "ref": "EQ_Q_RANGE",
      "perBand": true,
      "defaultRef": "EQ_BAND_DEFAULTS.q"
    },
    {
      "symbol": "on",
      "name": "On",
      "ref": "EQ_BAND_ONS",
      "perBand": true
    }
  ],
  "portHints": {
    "hpf_on": {
      "props": [
        "lv2:toggled"
      ]
    },
    "hpf_freq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "hpf_slope": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "12 12 dB/oct",
        "24 24 dB/oct"
      ]
    },
    "lpf_on": {
      "props": [
        "lv2:toggled"
      ]
    },
    "lpf_freq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "lpf_slope": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "12 12 dB/oct",
        "24 24 dB/oct"
      ]
    },
    "type": {
      "props": [
        "lv2:enumeration",
        "lv2:integer"
      ],
      "points": [
        "0 Bell",
        "1 Low Shelf",
        "2 High Shelf",
        "3 Notch",
        "4 All-pass 1st",
        "5 All-pass 2nd"
      ]
    },
    "freq": {
      "props": [
        "lv2:integer",
        "pprops:logarithmic"
      ],
      "unit": "units:hz"
    },
    "gain": {
      "unit": "units:db"
    },
    "on": {
      "props": [
        "lv2:toggled"
      ]
    },
    "enabled": {
      "props": [
        "lv2:toggled"
      ]
    },
    "latency": {
      "props": [
        "lv2:integer"
      ],
      "unit": "units:frame"
    }
  },
  "resourceHints": {
    "threads-spawned": 0,
    "streams-from-disk": false,
    "opens-sockets": false
  },
  "panel": {
    "family": "eq",
    "roles": {
      "band_type": "type",
      "band_freq": "freq",
      "band_gain": "gain",
      "band_q": "q",
      "band_on": "on",
      "hpf_freq": "hpf_freq",
      "hpf_slope": "hpf_slope",
      "hpf_on": "hpf_on",
      "lpf_freq": "lpf_freq",
      "lpf_slope": "lpf_slope",
      "lpf_on": "lpf_on"
    },
    "sections": [
      {
        "key": "bands",
        "label": "Bands",
        "controls": [
          "on",
          "type",
          "freq",
          "gain",
          "q"
        ],
        "graph": "eq-curve",
        "subgroups": "band"
      },
      {
        "key": "hpf",
        "label": "HPF",
        "controls": [
          "hpf_on",
          "hpf_slope",
          "hpf_freq"
        ]
      },
      {
        "key": "lpf",
        "label": "LPF",
        "controls": [
          "lpf_on",
          "lpf_slope",
          "lpf_freq"
        ]
      }
    ]
  },
  "manual": [
    "| Section | Parameters |",
    "|---|---|",
    "| High-pass | on/off, {range:hpf_freq}; slope {range:hpf_slope} |",
    "| Low-pass | on/off, {range:lpf_freq}; slope {range:lpf_slope} |",
    "| Bands 1 to {bands} | each on/off, type, frequency ({range:b1_freq}), gain ({range:b1_gain}), Q ({range:b1_q}; its top for a notch only) |",
    "",
    "Plus the host's bypass, which is the whole EQ's switch. Every band and filter starts off, so a freshly loaded instance passes the",
    "signal untouched."
  ],
  "console": {
    "$comment": "The OpenMixer console draws its eq stage: the EQ curve above the encoder bank, a chip per band (on, type, freq, gain, q) plus the HPF and LPF (on, slope, cutoff); the console's bands are a list the operator adds to, these variants' are fixed. Its chip shows the HPF while the HPF is on. Its overview card carries one gain per band, then the HPF frequency.",
    "placement": {
      "group": "walk",
      "stage": "eq",
      "after": "gate",
      "fxGroup": "eq"
    },
    "card": {
      "show": [
        "gain",
        "hpf_freq"
      ]
    },
    "chip": "HPF {hpf_freq}"
  }
}
